#!/usr/bin/env python3
"""dt as one word: `scripts/dt <command> …` runs dt.py with no `python3` in front, so a shell variable holding the
path works in zsh too."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from dt import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
