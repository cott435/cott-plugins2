# dev-team2 build-setup: tool caches, hook state, and probe secrets and raw output
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
.env
.env.*
!.env.example
probes/*/out/
probes/*/.env
.claude/.stop_attempts_*
.claude/.check_pkg
.claude/.task_writes
.claude/worktrees/
